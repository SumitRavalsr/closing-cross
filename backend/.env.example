# Defaults for local CLI use. Compose uses /data/scanner.sqlite3 instead.
DATABASE_PATH=scanner.sqlite3

PILOT_NSE_SYMBOL=RELIANCE
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Authenticator setup key, rather than the rotating six-digit code.
ANGEL_TOTP_SECRET=
# Optional manual authentication with a fresh six-digit code. Takes precedence over the setup key.
ANGEL_TOTP_CODE=
# Set these if your Angel One setup requires explicit client IP headers.
ANGEL_LOCAL_IP=
ANGEL_PUBLIC_IP=

# Hypothetical amounts in INR. The deterministic fixture uses fixed values.
PAPER_OPENING_CASH=1000.00
PAPER_ALLOCATION=1000.00
PAPER_FEE=2.00
PAPER_SLIPPAGE_PER_SHARE=1.00
