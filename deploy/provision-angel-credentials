#!/bin/bash
set -euo pipefail
umask 077

if (( EUID != 0 )) || [[ ! -t 0 || ! -t 2 ]]; then
    echo "Run this with sudo in an interactive VPS terminal." >&2
    exit 1
fi

directory=/etc/closing-cross
/usr/bin/install -d -m 0700 "$directory"
staging=$(/usr/bin/mktemp -d "$directory/.credentials.XXXXXXXX")
trap '/usr/bin/rm -f -- "$staging/angel.json.cred"; /usr/bin/rmdir -- "$staging"' EXIT

/usr/bin/python3 - <<'PY' | /usr/bin/systemd-creds encrypt --with-key=host --name=angel.json - "$staging/angel.json.cred"
import base64
import binascii
import getpass
import json
import sys
import warnings

warnings.simplefilter('error', getpass.GetPassWarning)
prompts = {
    'api_key': 'Angel One API key',
    'client_code': 'Angel One client code',
    'pin': 'Angel One login PIN',
    'totp_secret': 'Authenticator setup key (Base32)',
}
secret = {key: getpass.getpass(f'{prompt}: ').strip() for key, prompt in prompts.items()}
totp = ''.join(secret['totp_secret'].split()).upper()
try:
    decoded = base64.b32decode(totp + '=' * (-len(totp) % 8))
except binascii.Error:
    sys.exit('Invalid authenticator setup key.')
secret['totp_secret'] = totp
if not decoded or not all(value and value.isascii() and value.isprintable() for value in secret.values()):
    sys.exit('All four credential values must be populated and printable.')
json.dump(secret, sys.stdout)
PY

/usr/bin/chmod 0600 "$staging/angel.json.cred"
/usr/bin/mv -f -- "$staging/angel.json.cred" "$directory/angel.json.cred"
echo "Encrypted Angel One credentials installed on this VPS."
